{
    "layout": {
        "type": "layout",
        "pages": ["page-tiling", "page-snapping", "page-shortcuts", "page-file"],
        "page-tiling": {
            "type": "page",
            "title": "Tiling",
            "sections": ["section-panel", "section-tiling", "section-vertical", "section-horizontal", "section-gap", "section-resizing", "section-effects"]
        },
        "page-snapping": {
            "type": "page",
            "title": "Snapping",
            "sections": ["section-snapping"]
        },
        "page-shortcuts": {
            "type": "page",
            "title": "Keyboard shortcuts",
            "sections": ["section-tile-shortcuts", "section-toggle-shortcuts"]
        },
        "page-file": {
            "type": "page",
            "title": "Settings file",
            "sections": ["section-file"]
        },
        "section-panel": {
            "type": "section",
            "title": "Panel",
            "keys": ["showTilingMenu", "showResolutionMenu", "panelNote"]
        },
        "section-effects": {
            "type": "section",
            "title": "Window effects",
            "keys": ["windowEffects"]
        },
        "section-tiling": {
            "type": "section",
            "title": "Tiling",
            "keys": ["disabled", "tileNew", "showAuto"]
        },
        "section-vertical": {
            "type": "section",
            "title": "Vertical",
            "keys": ["directionsNote", "vertical", "wideMinWidth", "wideColumns", "normalColumns"]
        },
        "section-horizontal": {
            "type": "section",
            "title": "Horizontal",
            "keys": ["horizontal", "tallMinHeight", "tallRows", "normalRows"]
        },
        "section-gap": {
            "type": "section",
            "title": "Gap between windows",
            "keys": ["gapUnit", "gap", "gapMm"]
        },
        "section-resizing": {
            "type": "section",
            "title": "Resizing",
            "keys": ["resizeNeighbours"]
        },
        "section-snapping": {
            "type": "section",
            "title": "Snapping",
            "keys": ["snapNote", "snap", "snapShiftOnly", "snapShiftSwap"]
        },
        "section-tile-shortcuts": {
            "type": "section",
            "title": "Tiling",
            "keys": ["kbTileAuto", "kbTile4", "kbTile3", "kbTile2", "kbTileRows3", "kbTileRows2",
                     "kbTileGrid2x2", "kbTileGrid3x2", "kbTileGrid4x2", "kbRestore"]
        },
        "section-toggle-shortcuts": {
            "type": "section",
            "title": "Switches",
            "keys": ["kbToggleSnap", "kbToggleTileNew", "kbToggleDisabled"]
        },
        "section-file": {
            "type": "section",
            "title": "Settings file",
            "keys": ["settingsFileNote", "saveSettingsFile", "loadSettingsFile"]
        }
    },

    "disabled": {
        "type": "switch",
        "default": false,
        "description": "Disable tiling completely",
        "tooltip": "Nothing is tiled or snapped while this is on; Restore windows still works."
    },
    "tileNew": {
        "type": "switch",
        "default": false,
        "description": "Tile new windows automatically",
        "tooltip": "Each window that opens is tiled together with the others on its screen, in the layout last used there (at first, “Tile automatically”).",
        "dependency": "!disabled"
    },
    "showAuto": {
        "type": "switch",
        "default": true,
        "description": "Show “Tile automatically” in the menu",
        "tooltip": "Turn off to keep only the entries with a fixed number of columns or rows."
    },

    "directionsNote": {
        "type": "label",
        "description": "With both vertical and horizontal on, windows are tiled into a grid of columns and rows. With both off, they are tiled into columns."
    },
    "vertical": {
        "type": "switch",
        "default": true,
        "description": "Tile into columns side by side"
    },
    "wideMinWidth": {
        "type": "spinbutton",
        "default": 5120,
        "min": 640,
        "max": 32768,
        "step": 1,
        "units": "pixels",
        "description": "Wide screen from",
        "dependency": "vertical"
    },
    "wideColumns": {
        "type": "spinbutton",
        "default": 3,
        "min": 1,
        "max": 8,
        "step": 1,
        "units": "",
        "description": "Columns on wide screens",
        "dependency": "vertical"
    },
    "normalColumns": {
        "type": "spinbutton",
        "default": 2,
        "min": 1,
        "max": 8,
        "step": 1,
        "units": "",
        "description": "Columns on other screens",
        "dependency": "vertical"
    },

    "horizontal": {
        "type": "switch",
        "default": false,
        "description": "Tile into rows stacked top to bottom"
    },
    "tallMinHeight": {
        "type": "spinbutton",
        "default": 2160,
        "min": 480,
        "max": 32768,
        "step": 1,
        "units": "pixels",
        "description": "Tall screen from",
        "dependency": "horizontal"
    },
    "tallRows": {
        "type": "spinbutton",
        "default": 3,
        "min": 1,
        "max": 8,
        "step": 1,
        "units": "",
        "description": "Rows on tall screens",
        "dependency": "horizontal"
    },
    "normalRows": {
        "type": "spinbutton",
        "default": 2,
        "min": 1,
        "max": 8,
        "step": 1,
        "units": "",
        "description": "Rows on other screens",
        "dependency": "horizontal"
    },

    "gapUnit": {
        "type": "combobox",
        "default": "px",
        "description": "Unit",
        "options": {
            "pixels": "px",
            "millimetres (from the screen's physical size)": "mm"
        }
    },
    "gap": {
        "type": "spinbutton",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 1,
        "units": "pixels",
        "description": "Gap",
        "dependency": "gapUnit=px"
    },
    "gapMm": {
        "type": "spinbutton",
        "default": 2,
        "min": 0,
        "max": 50,
        "step": 1,
        "units": "mm",
        "description": "Gap",
        "dependency": "gapUnit=mm"
    },

    "resizeNeighbours": {
        "type": "switch",
        "default": false,
        "description": "Resize neighbouring windows together",
        "tooltip": "Dragging the left or right edge of a window also moves the edge of the window next to it, so windows side by side stay together."
    },

    "snapNote": {
        "type": "label",
        "description": "Drag a window with the mouse and let go: with automatic tiling on, it fills the column, row or grid cell under the pointer. With “Only when Shift is held”, a window dropped normally stays where it is. Holding Shift can also swap columns and rows: windows then snap into rows instead of columns (or columns instead of rows, or a grid turned on its side)."
    },
    "snap": {
        "type": "switch",
        "default": false,
        "description": "Automatic tiling: snap windows into place when dropped"
    },
    "snapShiftOnly": {
        "type": "switch",
        "default": false,
        "description": "Only when Shift is held while dropping",
        "dependency": "snap"
    },
    "snapShiftSwap": {
        "type": "switch",
        "default": false,
        "description": "Hold Shift to swap columns and rows",
        "dependency": "snap"
    },

    "kbTileAuto": {"type": "keybinding", "default": "<Super><Alt>a", "description": "Tile automatically"},
    "kbTile4": {"type": "keybinding", "default": "<Super><Alt>4", "description": "Tile in 4 columns"},
    "kbTile3": {"type": "keybinding", "default": "<Super><Alt>3", "description": "Tile in 3 columns"},
    "kbTile2": {"type": "keybinding", "default": "<Super><Alt>2", "description": "Tile in 2 columns"},
    "kbTileRows3": {"type": "keybinding", "default": "<Super><Primary><Alt>3", "description": "Tile in 3 rows"},
    "kbTileRows2": {"type": "keybinding", "default": "<Super><Primary><Alt>2", "description": "Tile in 2 rows"},
    "kbTileGrid2x2": {"type": "keybinding", "default": "<Super><Primary>2", "description": "Tile in 2 × 2 grid"},
    "kbTileGrid3x2": {"type": "keybinding", "default": "<Super><Primary>3", "description": "Tile in 3 × 2 grid"},
    "kbTileGrid4x2": {"type": "keybinding", "default": "<Super><Primary>4", "description": "Tile in 4 × 2 grid"},
    "kbRestore": {"type": "keybinding", "default": "<Super><Alt>0", "description": "Restore windows"},
    "kbToggleSnap": {"type": "keybinding", "default": "", "description": "Turn automatic tiling on or off"},
    "kbToggleTileNew": {"type": "keybinding", "default": "", "description": "Turn tiling new windows on or off"},
    "kbToggleDisabled": {"type": "keybinding", "default": "", "description": "Disable or enable tiling"},

    "defaultShortcuts": {"type": "generic", "default": 0},

    "showTilingMenu": {
        "type": "switch",
        "default": true,
        "description": "Show the Window Tiling menu on the panel"
    },
    "showResolutionMenu": {
        "type": "switch",
        "default": true,
        "description": "Show the Resolution menu on the panel"
    },
    "panelNote": {
        "type": "label",
        "description": "Turning a menu off takes it off the panel, as Quit in its menu does."
    },
    "windowEffects": {
        "type": "switch",
        "default": true,
        "description": "Window effects: animations of windows, menus and workspaces",
        "tooltip": "The same as Window effects in System Settings > Effects."
    },

    "settingsFileNote": {
        "type": "label",
        "description": "The settings of both menus and the keyboard shortcuts, to keep a copy or to use them on another computer."
    },
    "saveSettingsFile": {
        "type": "button",
        "description": "Save settings to file…",
        "callback": "saveSettingsFile"
    },
    "loadSettingsFile": {
        "type": "button",
        "description": "Load settings from file…",
        "callback": "loadSettingsFile"
    }
}
