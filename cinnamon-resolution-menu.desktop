[Desktop Entry]
Version=1.0
Type=Application
Name=Resolution Menu
Comment=Put the screen resolution menu on the panel, also after Quit
Icon=video-display
Exec=cinnamon-tile-menu setup resolution
Terminal=false
StartupNotify=false
Categories=Utility;
Keywords=resolution;screen;display;xrandr;
OnlyShowIn=X-Cinnamon;
