[Desktop Entry]
Version=1.0
Type=Application
Name=Window Tiling panel setup
Comment=Add the Window Tiling and Resolution applets to the panel once per user
Exec=cinnamon-tile-menu setup --auto
Terminal=false
NoDisplay=true
OnlyShowIn=X-Cinnamon;
